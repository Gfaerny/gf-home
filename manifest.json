{
  "manifest_version": 2,
  "name": "gf-home",
  "version": "1.0.0",
  "description": "Minimal homepage extension for firefox",
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": [
          "searchTerms"
        ]
      },
    "id": "gf-home@gfaerny",
    "strict_min_version": "142.0"
    }
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "bookmarks",
    "history",
    "search",
    "storage",
    "<all_urls>"
  ]
}
